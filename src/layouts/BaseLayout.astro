---
import '../styles/global.css';
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Jersey Round Table — service, fundraising and friendship since 1948.',
  ogImage = '/og-default.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: 'Jersey Round Table',
  url: Astro.site?.toString(),
  foundingDate: '1948',
  areaServed: 'Jersey, Channel Islands',
  sameAs: [
    'https://www.facebook.com/jerseyroundtable/',
    'https://www.instagram.com/jerseyroundtable/',
    'https://x.com/JsyRoundTable',
  ],
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <footer class="border-t border-black/5 bg-rt-paper mt-16">
      <div class="mx-auto max-w-(--container-max) px-6 py-12 grid gap-10 md:grid-cols-4 text-sm">
        <div class="md:col-span-2">
          <p class="font-semibold text-rt-navy text-base">Jersey Round Table</p>
          <p class="mt-2 text-rt-mute max-w-md">
            Chapter of Round Table Great Britain &amp; Ireland. Chartered in Jersey in 1948.
            Non-political, non-religious, men aged 18&ndash;45.
          </p>
          <p class="mt-4 text-rt-mute">
            Member <a href="https://www.jerseycharities.org/members/15/jersey-round-table" class="text-rt-navy underline underline-offset-4">#15</a> of the Association of Jersey Charities.
          </p>
        </div>
        <div>
          <p class="font-medium text-rt-navy">Explore</p>
          <ul class="mt-3 space-y-2 list-none p-0">
            <li><a href="/about" class="text-rt-ink hover:text-rt-navy">About</a></li>
            <li><a href="/what-we-do" class="text-rt-ink hover:text-rt-navy">What we do</a></li>
            <li><a href="/events" class="text-rt-ink hover:text-rt-navy">Events</a></li>
            <li><a href="/grants" class="text-rt-ink hover:text-rt-navy">Apply for a grant</a></li>
            <li><a href="/join" class="text-rt-ink hover:text-rt-navy">Join us</a></li>
            <li><a href="/contact" class="text-rt-ink hover:text-rt-navy">Contact</a></li>
          </ul>
        </div>
        <div>
          <p class="font-medium text-rt-navy">Follow</p>
          <ul class="mt-3 space-y-2 list-none p-0">
            <li><a href="https://www.facebook.com/jerseyroundtable/" rel="me noopener" class="text-rt-ink hover:text-rt-navy">Facebook</a></li>
            <li><a href="https://www.instagram.com/jerseyroundtable/" rel="me noopener" class="text-rt-ink hover:text-rt-navy">Instagram</a></li>
            <li><a href="https://x.com/JsyRoundTable" rel="me noopener" class="text-rt-ink hover:text-rt-navy">X / Twitter</a></li>
            <li><a href="https://www.roundtable.co.uk" rel="noopener" class="text-rt-ink hover:text-rt-navy">RTBI (parent)</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-black/5">
        <div class="mx-auto max-w-(--container-max) px-6 py-6 flex flex-wrap items-center justify-between gap-3 text-xs text-rt-mute">
          <p>&copy; {new Date().getFullYear()} Jersey Round Table.</p>
          <p>Adopt &middot; Adapt &middot; Improve</p>
        </div>
      </div>
    </footer>
  </body>
</html>
