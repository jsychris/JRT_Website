---
interface Props {
  title?: string;
  message?: string;
}
const {
  title = 'Something went wrong',
  message = "We couldn't load this content. Try refreshing, or get in touch if it persists.",
} = Astro.props;
---
<div class="rounded-(--radius-card) border border-red-200 bg-red-50 p-6" role="alert">
  <h3 class="text-red-900">{title}</h3>
  <p class="mt-2 text-sm text-red-900/80">{message}</p>
  <a href="/contact" class="inline-block mt-4 text-sm font-medium text-red-900 underline underline-offset-4">
    Contact us
  </a>
</div>
