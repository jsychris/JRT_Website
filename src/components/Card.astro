---
interface Props {
  href?: string;
  class?: string;
}
const { href, class: className = '' } = Astro.props;

const classes = `block rounded-(--radius-card) bg-white shadow-(--shadow-sm) hover:shadow-(--shadow-md) transition-shadow duration-150 p-6 no-underline text-rt-ink ${className}`;
---
{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <article class={classes}>
      <slot />
    </article>
  )
}
