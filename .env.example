# Production: attach a Railway volume at /data (Railway sets RAILWAY_VOLUME_MOUNT_PATH).
# Local development only:
DATA_DIRECTORY=/absolute/path/to/jrt-data
# Exact external origin, without trailing path; use the existing club domain.
APP_URL=https://www.jerseyroundtable.com
# SHA-256 hex digest of a random one-time administrator setup code. Never commit the code.
CLUB_SETUP_HASH=
